<form id="request-form" class="request-form">
  <div class="form-field">
    <label for="client-name">Seu nome *</label>
    <input
      id="client-name"
      name="name"
      type="text"
      placeholder="Como podemos te chamar?"
      autocomplete="name"
      required
    />
  </div>

  <div class="form-row">
    <div class="form-field">
      <label for="project-type">Tipo de projeto *</label>
      <select id="project-type" name="type" required>
        <option value="" disabled selected>Selecione</option>
        <option>Miniatura / colecionável</option>
        <option>Peça funcional</option>
        <option>Protótipo</option>
        <option>Decoração</option>
        <option>Peça personalizada</option>
        <option>Outro</option>
      </select>
    </div>

    <div class="form-field">
      <label for="project-quantity">Quantidade</label>
      <input
        id="project-quantity"
        name="quantity"
        type="number"
        min="1"
        placeholder="Ex.: 2"
      />
    </div>
  </div>

  <div class="form-field">
    <label for="project-size">Tamanho aproximado</label>
    <input
      id="project-size"
      name="size"
      type="text"
      placeholder="Ex.: 15 cm de altura"
    />
  </div>

  <div class="form-field">
    <label for="project-description">Conte sobre sua ideia *</label>
    <textarea
      id="project-description"
      name="description"
      rows="5"
      placeholder="Explique o que você quer imprimir ou criar..."
      required
    ></textarea>
  </div>

  <div class="form-field">
    <label for="project-reference">Link de referência (opcional)</label>
    <input
      id="project-reference"
      name="reference"
      type="url"
      placeholder="https://..."
    />
  </div>

  <button class="button button-dark form-submit" type="submit">
    Enviar pelo WhatsApp ↗
  </button>

  <p class="form-note">
    O formulário abre o WhatsApp com os dados preenchidos.
    Você poderá anexar fotos e arquivos na conversa.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#request-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = new FormData(form);

    const get = (key: string) =>
      String(data.get(key) ?? '').trim();

    const message = [
      'Olá! Gostaria de solicitar um projeto na Baryon Lab.',
      '',
      `Nome: ${get('name')}`,
      `Tipo: ${get('type')}`,
      get('quantity') ? `Quantidade: ${get('quantity')}` : '',
      get('size') ? `Tamanho: ${get('size')}` : '',
      '',
      'Descrição do projeto:',
      get('description'),
      get('reference')
        ? `\nReferência: ${get('reference')}`
        : '',
    ]
      .filter(Boolean)
      .join('\n');

    const url =
      'https://wa.me/5541991613019?text=' +
      encodeURIComponent(message);

    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>