---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<header class="site-header" id="topo">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="Baryon Lab — início">
      <img
        src={`${base}baryon-lab-logo.png`}
        alt="Baryon Lab"
      />
      <span class="brand-fallback">BARYON LAB</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="#portfolio">Portfólio</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#solicitar">Solicitar</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">
        Instagram ↗
      </a>
    </nav>

    <a class="header-cta button button-purple" href="#solicitar">
      Pedir orçamento ↗
    </a>

    <details class="mobile-menu">
      <summary aria-label="Abrir ou fechar menu">
        <span>MENU</span>
        <span class="menu-symbol" aria-hidden="true"></span>
      </summary>

      <nav aria-label="Navegação mobile">
        <a href="#portfolio">Portfólio <span>↗</span></a>
        <a href="#como-funciona">Como funciona <span>↗</span></a>
        <a href="#solicitar">Solicitar projeto <span>↗</span></a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          Instagram <span>↗</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');

  mobileMenu?.querySelectorAll('nav a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.open = false;
    });
  });
</script>