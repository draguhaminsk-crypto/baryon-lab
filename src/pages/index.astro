---
import Header from '../components/Header.astro';
import RequestForm from '../components/RequestForm.astro';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const portfolioProjects = [
  {
    title: 'Miniaturas e colecionáveis',
    category: 'Decoração',
    description:
      'Personagens, figuras e peças especiais para colecionar, presentear ou decorar.',
    image:
      'https://makerworld.bblmw.com/makerworld/model/USd7e00efde266eb/design/243d17e5563d9881.jpg?x-oss-process=image/resize,w_1000/format,webp',
    sideImage1:
      'https://images.unsplash.com/photo-1756723902896-94e2d9332fbd?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage2:
      'https://images.unsplash.com/photo-1741517669003-94a4cb80f793?auto=format&fit=crop&fm=jpg&q=82&w=1600',
  },
  {
    title: 'Peças funcionais',
    category: 'Utilidades',
    description:
      'Soluções práticas, suportes e peças pensadas para resolver problemas do dia a dia.',
    image:
      'https://images.unsplash.com/photo-1741517669003-94a4cb80f793?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage1:
      'https://images.unsplash.com/photo-1756723901904-15a28ffb0814?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage2:
      'https://images.unsplash.com/photo-1756723902460-235b1f21ad05?auto=format&fit=crop&fm=jpg&q=82&w=1600',
  },
  {
    title: 'Projetos personalizados',
    category: 'Custom',
    description:
      'Ideias que começam como referência e ganham uma forma própria.',
    image:
      'https://images.unsplash.com/photo-1756723901904-15a28ffb0814?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage1:
      'https://images.unsplash.com/photo-1756723903184-32fed816ea5d?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage2:
      'https://images.unsplash.com/photo-1756723902896-94e2d9332fbd?auto=format&fit=crop&fm=jpg&q=82&w=1600',
  },
  {
    title: 'Peças sob medida',
    category: 'Personalização',
    description:
      'Soluções pensadas para encaixar na sua ideia e no seu uso.',
    image:
      'https://images.unsplash.com/photo-1756723902460-235b1f21ad05?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage1:
      'https://images.unsplash.com/photo-1756723901904-15a28ffb0814?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage2:
      'https://images.unsplash.com/photo-1756723903184-32fed816ea5d?auto=format&fit=crop&fm=jpg&q=82&w=1600',
  },
  {
    title: 'Decoração e utilidades',
    category: 'Objetos',
    description:
      'Peças criativas para organizar, decorar e dar forma às suas ideias.',
    image:
      'https://images.unsplash.com/photo-1756723903184-32fed816ea5d?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage1:
      'https://images.unsplash.com/photo-1756723902896-94e2d9332fbd?auto=format&fit=crop&fm=jpg&q=82&w=1600',
    sideImage2:
      'https://images.unsplash.com/photo-1741517669003-94a4cb80f793?auto=format&fit=crop&fm=jpg&q=82&w=1600',
  },
];
---

<Layout
  title={`${site.name} — Impressão 3D`}
  description={site.description}
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="hero-label">
            <span class="dot"></span>
            IMPRESSÃO 3D / PROJETOS SOB MEDIDA
          </div>

          <h1>
            Ideias viram
            <span>coisas.</span>
          </h1>

          <p class="hero-text">
            A Baryon Lab transforma referências, arquivos e ideias
            em objetos reais. Peças funcionais, miniaturas,
            protótipos e projetos personalizados.
          </p>

          <div class="hero-actions">
            <a href="#solicitar" class="button button-purple">
              Fazer um projeto ↗
            </a>

            <a href="#portfolio" class="button button-outline">
              Ver portfólio
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-visual-top">
            <span>BARYON / LAB</span>
            <span>3D.001</span>
          </div>

          <div class="hero-logo">
            <img
              src={`${base}baryon-lab-logo.png`}
              alt="Logo da Baryon Lab"
              loading="eager"
            />
          </div>

          <div class="hero-visual-bottom">
            <span>MODEL</span>
            <span>PRINT</span>
            <span>BUILD</span>
          </div>
        </div>
      </div>

      <div class="ticker" aria-label="Serviços da Baryon Lab">
        <div class="ticker-track">
          <span>IMPRESSÃO 3D ✦</span>
          <span>PEÇAS PERSONALIZADAS ✦</span>
          <span>PROTOTIPAGEM ✦</span>
          <span>MINIATURAS ✦</span>
          <span>IDEIA → OBJETO ✦</span>
          <span>IMPRESSÃO 3D ✦</span>
          <span>PEÇAS PERSONALIZADAS ✦</span>
          <span>PROTOTIPAGEM ✦</span>
        </div>
      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="manifesto">
      <div class="container">
        <span class="tiny-title">[ BARYON LAB ]</span>

        <p>
          NÃO É SÓ APERTAR
          <strong>PRINT.</strong>
          É PEGAR UMA IDEIA
          E FAZER ELA
          <span>EXISTIR.</span>
        </p>
      </div>
    </section>

    <!-- PORTFÓLIO -->
    <section class="section portfolio" id="portfolio">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="tiny-title">[ PORTFÓLIO ]</p>
            <h2>
              Coisas que saíram
              <span>da bancada.</span>
            </h2>
          </div>

          <p class="section-description">
            Algumas imagens ainda são provisórias.
            Conforme novos projetos forem sendo feitos,
            esse espaço vira o arquivo real da Baryon Lab.
          </p>
        </div>

        <div class="portfolio-compositions">
          {
            portfolioProjects.map((project, index) => (
              <article
                class={`portfolio-composition composition-${index + 1}`}
              >
                <!-- CARD PRINCIPAL -->
                <div class="portfolio-main-card">
                  <span class="project-number">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <div class="portfolio-main-media">
                    <img
                      src={project.image}
                      alt={project.title}
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </div>

                  <div class="project-content">
                    <p class="project-category">
                      {project.category}
                    </p>

                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                  </div>
                </div>

                <!-- FOTO LATERAL 1 -->
                <div class="portfolio-photo">
                  <img
                    src={project.sideImage1}
                    alt={`${project.title} — foto complementar 1`}
                    loading="lazy"
                  />
                </div>

                <!-- FOTO LATERAL 2 -->
                <div class="portfolio-photo">
                  <img
                    src={project.sideImage2}
                    alt={`${project.title} — foto complementar 2`}
                    loading="lazy"
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAIXA ROXA -->
    <div class="purple-strip">
      <div class="strip-track">
        <span>MODELAR ✦</span>
        <span>TESTAR ✦</span>
        <span>IMPRIMIR ✦</span>
        <span>MONTAR ✦</span>
        <span>REPETIR ✦</span>
        <span>MODELAR ✦</span>
        <span>TESTAR ✦</span>
      </div>
    </div>

    <!-- PROCESSO -->
    <section class="section process" id="como-funciona">
      <div class="container">
        <div class="process-heading">
          <p class="tiny-title">[ COMO FUNCIONA ]</p>
          <h2>
            Do arquivo
            <span>pra sua mão.</span>
          </h2>
        </div>

        <div class="process-grid">
          <article>
            <span class="step-number">01</span>
            <h3>Você manda a ideia</h3>
            <p>
              Pode ser STL, foto, referência, desenho
              ou simplesmente uma explicação.
            </p>
          </article>

          <article>
            <span class="step-number">02</span>
            <h3>A gente planeja</h3>
            <p>
              Tamanho, material, resistência,
              acabamento e quantidade.
            </p>
          </article>

          <article>
            <span class="step-number">03</span>
            <h3>A máquina trabalha</h3>
            <p>
              A peça ganha forma camada por camada.
            </p>
          </article>

          <article>
            <span class="step-number">04</span>
            <h3>Projeto pronto</h3>
            <p>
              Ajustes, acabamento, montagem e entrega.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- CHAMADA -->
    <section class="big-cta">
      <div class="container">
        <p>
          TEM UMA IDEIA MEIO
          <span>ESTRANHA?</span>
        </p>

        <a href="#solicitar">
          ÓTIMO. VAMOS FAZER ↘
        </a>
      </div>
    </section>

    <!-- SOLICITAÇÃO -->
    <section class="section request" id="solicitar">
      <div class="container request-grid">
        <div class="request-copy">
          <p class="tiny-title">[ SOLICITAR PROJETO ]</p>

          <h2>
            Bora fazer
            <span>isso.</span>
          </h2>

          <p class="request-description">
            Conta pra gente o que você precisa.
            O formulário organiza as informações
            e abre tudo no WhatsApp.
          </p>

          <div class="whatsapp-box">
            <small>WHATSAPP</small>
            <strong>41 99161-3019</strong>
          </div>
        </div>

        <div class="form-box">
          <div class="form-title">
            <span>NOVO PROJETO</span>
            <span>BARYON_REQUEST</span>
          </div>

          <RequestForm />
        </div>
      </div>
    </section>
  </main>

  <!-- RODAPÉ -->
  <footer class="footer">
    <div class="container footer-grid">
      <a class="footer-logo" href="#inicio">
        <img
          src={`${base}baryon-lab-logo.png`}
          alt="Baryon Lab"
          loading="lazy"
        />
      </a>

      <div class="footer-name">
        BARYON
        <span>LAB</span>
      </div>

      <nav aria-label="Links do rodapé">
        <a href="#inicio">Topo ↑</a>
        <a href="#portfolio">Portfólio</a>
        <a href="#solicitar">Orçamento</a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram ↗
        </a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>BARYON LAB © 2026</span>
      <span>IDEIA → MODELO → OBJETO</span>
    </div>
  </footer>
</Layout>