---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baryon Lab — Impressão 3D',
  description = 'Portfólio e solicitações de impressão 3D da Baryon Lab.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/png" href="/logo-baryon-lab.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
