---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baryon Lab — Impressão 3D',
  description = 'Impressão 3D, miniaturas, peças funcionais e projetos personalizados.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#f0ede5" />
    <meta name="description" content={description} />

    <link
      rel="icon"
      type="image/png"
      href={`${base}baryon-lab-logo.png`}
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>